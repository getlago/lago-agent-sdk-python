# Copy this file to examples/.env and fill in real values.
# examples/.env is gitignored — never commit real credentials.

CF_ACCOUNT_ID=
CF_GATEWAY_ID=
CF_LOGS_TOKEN=
# Also doubles as the Cloudflare API token for live workers-ai pricing (via
# Cloudflare's own model catalog) — no separate credential needed for that.
CF_GATEWAY_AUTH=

LAGO_API_KEY=
LAGO_API_URL=https://api.getlago.com/api/v1
LAGO_SUBSCRIPTION_ID=cloudflare_gateway_demo_sub
# Set to false ONLY for a local dev Lago instance behind a self-signed cert
# (e.g. LAGO_API_URL=https://api.lago.dev/api/v1). Never for a real Lago URL.
LAGO_VERIFY_SSL=true

# Only needed for the provider you pick in Part 2 — workers-ai needs neither.
ANTHROPIC_API_KEY=
# wrap()-ing the Mistral client auto-detects this key for pricing's alias
# resolution too (see LagoConfig.mistral_api_key) — no separate credential
# needed for that.
MISTRAL_API_KEY=
